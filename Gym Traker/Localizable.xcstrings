          }
        }
      }
    },
    "Something broken, missing or just wrong? Say so — it goes straight to the person who builds this.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualcosa non va, manca o è sbagliato? Scrivilo: arriva direttamente a chi sviluppa l'app."
          }
