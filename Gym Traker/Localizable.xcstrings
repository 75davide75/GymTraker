      }
    },
    "Only fills what you have left blank. Anything you typed here stays as you set it.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riempie solo ciò che hai lasciato vuoto. Quello che hai scritto tu resta com'è."
          }
        }
      }
    },
    "Bodyweight drives every strength tier, so keeping it current keeps the ladder honest.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il peso corporeo determina ogni livello di forza: tenerlo aggiornato tiene onesta la scala."
          }
        }
      }
    },
    "Pull bodyweight, sex and age from Health, and bring in workouts recorded elsewhere — including sessions from your Apple Watch.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prende peso, sesso ed età da Salute e importa gli allenamenti registrati altrove, comprese le sessioni da Apple Watch."
          }
        }
      }
    },
    "A workout started on the Watch appears here once it ends — Health only publishes a workout when it is saved.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un allenamento iniziato su Watch compare qui quando finisce: Salute lo pubblica solo al salvataggio."
          }
        }
      }
    },
    "Health is not available on this device.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salute non è disponibile su questo dispositivo."
          }
